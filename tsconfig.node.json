{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["vite.config.ts", "playwright.config.ts", "eslint.config.ts", "e2e/**/*"],
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "module": "preserve",
    "moduleResolution": "bundler",
    // Playwright's page callbacks are evaluated in the browser.
    "lib": ["ES2024", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"]
  }
}
